<office:master-styles>
<style:master-page style:name="Standard" style:page-layout-name="pm1">
<style:header><text:p>Верхний колонтитул: ACME Confidential</text:p></style:header>
<style:footer><text:p>Нижний колонтитул, страница <text:page-number>1</text:page-number></text:p></style:footer>
