<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:automatic-styles>
<style:style style:name="B" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
<style:style style:name="I" style:family="text"><style:text-properties fo:font-style="italic"/></style:style>
<style:style style:name="H" style:family="text"><style:text-properties text:display="none"/></style:style>
</office:automatic-styles><office:body><office:text><text:h text:outline-level="1">Section 0</text:h><text:p>lambda epsilon nu phi beta gamma sigma delta mu tau beta rho eta beta gamma xi xi gamma theta gamma sigma xi beta tau delta theta phi phi tau beta <text:span text:style-name="B">tau tau nu</text:span> beta theta beta sigma epsilon kappa xi epsilon sigma delta<text:span text:style-name="H">tau kappa sigma chi</text:span></text:p><text:p>zeta delta tau tau phi eta mu delta sigma psi gamma tau beta upsilon eta pi chi sigma xi lambda omicron tau omicron mu kappa theta zeta psi theta gamma <text:span text:style-name="B">tau kappa rho</text:span> pi lambda omega omicron kappa upsilon gamma delta rho xi</text:p><text:p>zeta lambda epsilon pi xi beta chi gamma sigma tau lambda lambda psi mu upsilon pi tau omicron gamma gamma iota pi psi chi gamma beta omega psi kappa phi <text:span text:style-name="B">tau chi omicron</text:span> kappa psi nu chi mu alpha omicron mu zeta upsilon</text:p><text:p>delta pi beta eta kappa epsilon omega theta nu nu pi gamma zeta omicron nu sigma iota epsilon xi sigma iota psi xi mu chi nu theta epsilon gamma zeta <text:span text:style-name="B">epsilon theta chi</text:span> theta alpha pi tau zeta iota kappa alpha epsilon xi</text:p><text:p>sigma mu upsilon tau lambda epsilon psi rho upsilon phi chi omega beta omicron chi sigma nu nu nu nu delta pi phi nu beta eta gamma eta omicron zeta <text:span text:style-name="B">delta lambda upsilon</text:span> beta delta alpha tau epsilon sigma delta mu upsilon alpha</text:p><text:p>gamma eta upsilon nu epsilon phi iota mu upsilon mu pi delta delta pi omicron pi pi kappa gamma epsilon delta omega lambda omega iota pi psi zeta rho alpha <text:span text:style-name="B">eta rho mu</text:span> epsilon psi sigma alpha rho kappa phi gamma psi iota</text:p><text:p>rho mu zeta mu theta sigma sigma rho lambda phi theta upsilon eta theta nu omega theta eta rho pi mu omega alpha alpha iota pi iota eta psi upsilon <text:span text:style-name="B">mu omicron omega</text:span> mu mu gamma theta delta theta pi eta lambda eta</text:p><text:p>pi upsilon upsilon alpha pi phi mu phi gamma chi delta nu psi eta pi zeta xi phi lambda gamma omega nu omicron nu omega gamma omega zeta zeta epsilon <text:span text:style-name="B">alpha epsilon tau</text:span> omicron phi epsilon upsilon upsilon pi chi mu epsilon sigma</text:p><text:p>sigma epsilon alpha alpha omega phi delta rho omega epsilon xi eta eta alpha iota eta kappa rho theta tau lambda iota sigma xi epsilon beta omega mu omicron chi <text:span text:style-name="B">tau rho xi</text:span> rho epsilon sigma epsilon rho rho alpha omicron zeta upsilon</text:p><text:p>alpha epsilon zeta epsilon pi upsilon omega delta sigma beta lambda chi rho rho sigma pi delta sigma beta theta eta iota beta delta rho omicron sigma alpha gamma omicron <text:span text:style-name="B">lambda upsilon rho</text:span> upsilon rho eta psi iota omicron rho sigma pi rho</text:p><text:p>theta psi rho iota sigma eta omicron epsilon xi delta nu omicron lambda gamma chi theta xi gamma eta chi kappa delta epsilon psi phi chi mu epsilon iota epsilon <text:span text:style-name="B">omicron theta omega</text:span> delta nu pi zeta chi theta zeta psi xi rho</text:p><text:p>nu lambda xi eta mu lambda gamma omega mu alpha lambda sigma omicron omicron psi alpha nu lambda rho upsilon kappa rho gamma delta theta delta gamma iota iota beta <text:span text:style-name="B">zeta iota epsilon</text:span> xi chi iota nu epsilon sigma rho tau pi psi<text:span text:style-name="H">lambda gamma iota beta</text:span></text:p><text:p>psi zeta xi gamma iota alpha phi gamma iota gamma upsilon theta gamma iota delta omicron alpha lambda sigma xi iota upsilon epsilon beta rho psi theta delta zeta iota <text:span text:style-name="B">beta zeta eta</text:span> kappa phi kappa rho eta kappa omicron rho chi zeta</text:p><text:p>iota mu alpha iota beta alpha alpha omega rho sigma eta rho pi theta omicron delta chi phi xi chi pi sigma nu rho kappa psi eta theta lambda eta <text:span text:style-name="B">psi omega phi</text:span> epsilon nu mu beta epsilon alpha gamma phi omega iota</text:p><text:p>xi zeta beta gamma chi nu rho chi kappa upsilon theta psi kappa beta omicron zeta zeta iota omicron alpha iota mu lambda sigma lambda theta beta kappa eta mu <text:span text:style-name="B">zeta alpha lambda</text:span> nu gamma pi iota rho phi eta theta rho alpha</text:p><text:p>gamma iota gamma epsilon nu tau beta nu alpha kappa kappa phi theta gamma tau rho epsilon chi psi upsilon nu lambda omega pi epsilon kappa omega upsilon phi epsilon <text:span text:style-name="B">beta psi rho</text:span> phi xi omega psi rho epsilon rho rho tau alpha</text:p><text:p>chi tau psi chi psi phi theta gamma alpha beta epsilon phi mu delta nu omicron sigma beta phi alpha phi sigma chi theta pi iota alpha omicron gamma omega <text:span text:style-name="B">rho sigma gamma</text:span> chi rho gamma omega omega pi iota gamma iota theta</text:p><text:p>omega eta theta omega phi omicron pi nu gamma pi chi kappa beta upsilon phi phi eta gamma upsilon epsilon lambda iota phi omega psi kappa upsilon tau epsilon alpha <text:span text:style-name="B">pi beta pi</text:span> iota chi delta psi eta chi pi kappa psi rho</text:p><text:p>kappa omicron omicron omicron delta sigma eta kappa gamma pi alpha kappa omicron gamma rho omicron iota nu eta eta gamma tau gamma epsilon omega rho iota mu epsilon upsilon <text:span text:style-name="B">phi rho iota</text:span> delta psi mu theta pi pi nu alpha zeta alpha</text:p><text:p>pi chi omicron nu kappa omega epsilon xi mu nu lambda delta lambda alpha lambda lambda nu delta eta psi alpha omega kappa iota mu gamma nu nu tau gamma <text:span text:style-name="B">mu xi iota</text:span> beta iota delta beta chi kappa phi epsilon theta iota</text:p><text:h text:outline-level="2">Section 20</text:h><text:p>xi rho lambda eta mu xi alpha phi nu sigma sigma eta omega gamma beta omega xi omicron upsilon epsilon phi kappa pi beta sigma epsilon zeta pi xi lambda <text:span text:style-name="B">kappa kappa iota</text:span> omega omega phi iota nu phi theta kappa pi sigma</text:p><text:p>chi nu delta zeta phi zeta gamma eta rho pi sigma theta omicron lambda omicron xi epsilon sigma eta theta gamma zeta lambda sigma gamma lambda theta mu iota tau <text:span text:style-name="B">eta alpha omega</text:span> xi nu xi omega rho eta nu iota lambda beta</text:p><text:p>pi iota tau mu epsilon chi rho rho phi eta gamma iota theta nu nu phi omicron xi kappa alpha epsilon beta xi psi pi tau pi alpha gamma nu <text:span text:style-name="B">rho omicron omicron</text:span> theta delta theta epsilon epsilon rho chi delta omega psi<text:span text:style-name="H">phi omicron gamma sigma</text:span></text:p><text:p>beta alpha epsilon theta tau beta phi psi kappa epsilon phi iota rho phi xi psi delta delta gamma kappa rho tau eta nu iota theta upsilon alpha alpha sigma <text:span text:style-name="B">kappa omicron iota</text:span> lambda phi theta pi rho theta sigma theta alpha xi</text:p><text:p>psi phi kappa beta alpha eta pi chi phi xi gamma iota theta chi xi mu theta pi beta psi lambda psi xi mu chi nu eta alpha kappa omega <text:span text:style-name="B">rho gamma eta</text:span> pi eta kappa eta theta omicron theta iota kappa delta</text:p><text:p>upsilon pi upsilon zeta theta pi xi chi beta upsilon epsilon nu beta eta alpha upsilon epsilon xi beta psi beta zeta nu omicron psi lambda omega delta gamma zeta <text:span text:style-name="B">lambda eta zeta</text:span> phi rho omega omicron beta kappa chi omega nu mu</text:p><text:p>lambda omicron zeta delta alpha gamma iota gamma mu xi delta sigma eta nu mu kappa xi gamma beta psi pi eta mu sigma omicron eta lambda mu omega pi <text:span text:style-name="B">alpha phi xi</text:span> theta phi nu beta nu beta omicron gamma beta iota</text:p><text:p>eta omega gamma upsilon lambda mu iota lambda upsilon beta iota omega psi psi lambda iota kappa alpha omega upsilon phi gamma alpha theta delta pi psi omicron nu iota <text:span text:style-name="B">xi pi epsilon</text:span> pi zeta alpha omega kappa psi epsilon upsilon theta lambda</text:p><text:p>lambda omicron mu upsilon gamma rho eta nu zeta theta xi gamma phi beta pi sigma sigma lambda zeta xi delta gamma iota upsilon gamma eta delta xi pi psi <text:span text:style-name="B">omicron zeta theta</text:span> epsilon xi omicron upsilon chi theta omega sigma chi delta</text:p><text:p>kappa kappa iota tau iota mu iota omega iota eta omicron theta zeta theta theta epsilon kappa tau eta lambda gamma nu iota theta rho rho theta phi delta phi <text:span text:style-name="B">omicron beta delta</text:span> alpha pi theta omicron mu beta kappa theta delta beta</text:p><text:p>eta upsilon tau eta gamma mu rho zeta omicron upsilon iota chi alpha delta phi upsilon psi upsilon mu eta beta mu lambda epsilon beta eta iota beta upsilon omega <text:span text:style-name="B">phi eta alpha</text:span> lambda xi chi mu zeta upsilon kappa gamma eta beta</text:p><text:p>pi sigma pi gamma xi delta nu chi sigma epsilon phi sigma gamma phi zeta nu psi iota xi kappa chi kappa xi beta kappa omega tau mu xi xi <text:span text:style-name="B">alpha mu phi</text:span> eta nu omega nu eta alpha xi zeta xi delta</text:p><text:p>gamma nu tau mu omicron zeta epsilon alpha beta sigma epsilon phi nu gamma tau upsilon mu omega rho zeta epsilon mu kappa zeta rho zeta gamma delta nu pi <text:span text:style-name="B">eta kappa epsilon</text:span> beta pi lambda beta upsilon phi nu gamma psi upsilon</text:p><text:p>psi zeta phi theta upsilon nu upsilon eta pi zeta tau eta beta nu rho zeta nu mu delta epsilon theta omega eta beta sigma chi beta chi lambda delta <text:span text:style-name="B">nu upsilon omicron</text:span> sigma phi kappa phi xi kappa tau theta xi nu<text:span text:style-name="H">chi mu omicron rho</text:span></text:p><text:p>omicron zeta alpha alpha upsilon pi omicron theta omicron upsilon omicron zeta pi nu delta gamma epsilon mu xi mu gamma omicron rho rho chi beta beta phi epsilon gamma <text:span text:style-name="B">omega lambda omega</text:span> rho gamma beta rho nu phi epsilon alpha gamma upsilon</text:p><text:p>omega psi delta eta epsilon pi kappa zeta chi omega theta gamma mu upsilon iota zeta lambda upsilon iota omicron epsilon iota rho pi eta tau iota upsilon rho theta <text:span text:style-name="B">lambda mu beta</text:span> eta zeta nu zeta phi iota chi lambda nu zeta</text:p><text:p>iota delta rho beta phi mu omicron sigma rho tau psi delta iota sigma phi nu omega mu iota nu mu tau epsilon mu lambda gamma omicron theta zeta upsilon <text:span text:style-name="B">omega beta kappa</text:span> rho iota kappa phi tau chi lambda omega alpha omega</text:p><text:p>beta theta epsilon kappa upsilon phi xi xi rho mu beta epsilon pi theta upsilon phi beta alpha beta alpha tau mu kappa delta rho mu sigma theta xi tau <text:span text:style-name="B">kappa tau epsilon</text:span> eta mu upsilon pi zeta epsilon alpha theta psi epsilon</text:p><text:p>omicron delta gamma phi epsilon chi iota nu iota alpha beta phi sigma mu upsilon phi tau omicron upsilon rho omega pi theta zeta alpha beta beta sigma alpha nu <text:span text:style-name="B">zeta theta zeta</text:span> beta delta alpha upsilon sigma chi eta epsilon xi eta</text:p><text:p>rho upsilon phi rho phi phi xi upsilon zeta rho kappa gamma kappa phi beta omega pi psi sigma alpha nu xi omega omicron gamma omega phi omicron zeta theta <text:span text:style-name="B">delta iota theta</text:span> phi beta delta lambda omega psi iota psi beta iota</text:p><text:h text:outline-level="3">Section 40</text:h><text:p>phi sigma chi xi chi rho iota kappa phi eta gamma rho alpha zeta iota theta omega eta zeta omega lambda eta nu lambda upsilon theta nu phi psi chi <text:span text:style-name="B">sigma pi pi</text:span> rho psi alpha alpha xi omega theta tau kappa eta</text:p><text:p>nu upsilon tau gamma tau zeta epsilon beta alpha delta delta upsilon zeta mu epsilon psi alpha alpha beta epsilon psi phi phi beta psi gamma omega beta gamma tau <text:span text:style-name="B">mu eta sigma</text:span> chi gamma psi nu delta theta eta eta delta beta</text:p><text:p>beta phi gamma phi phi kappa pi delta epsilon delta phi eta kappa lambda lambda xi iota alpha mu iota kappa beta psi mu lambda upsilon rho pi kappa upsilon <text:span text:style-name="B">omega alpha xi</text:span> alpha xi rho delta mu pi psi beta sigma tau</text:p><text:p>eta psi gamma tau kappa zeta xi alpha rho eta kappa beta alpha mu pi delta pi psi zeta pi tau mu rho iota tau zeta kappa eta psi theta <text:span text:style-name="B">pi zeta delta</text:span> phi gamma pi psi sigma delta phi lambda mu delta</text:p><text:p>nu nu omega gamma xi phi alpha mu eta kappa iota xi sigma rho zeta nu phi theta omicron epsilon sigma upsilon psi upsilon phi beta mu tau lambda rho <text:span text:style-name="B">epsilon omicron chi</text:span> sigma omega lambda zeta omicron omicron psi iota tau theta<text:span text:style-name="H">epsilon lambda omicron phi</text:span></text:p><text:p>psi theta rho eta iota kappa psi upsilon epsilon omega epsilon theta omega lambda upsilon rho mu zeta theta lambda eta iota omega delta zeta chi delta eta nu epsilon <text:span text:style-name="B">epsilon kappa omega</text:span> kappa xi iota eta delta phi delta iota eta nu</text:p><text:p>omicron beta alpha nu xi psi theta rho phi kappa omicron alpha epsilon iota upsilon omega nu alpha omega theta xi psi tau tau omega phi xi theta chi omega <text:span text:style-name="B">phi phi psi</text:span> tau theta chi zeta phi delta omicron xi lambda iota</text:p><text:p>phi psi delta xi theta nu psi psi phi zeta iota xi pi omicron alpha upsilon xi rho chi chi zeta phi lambda alpha nu pi delta beta iota sigma <text:span text:style-name="B">eta zeta psi</text:span> eta rho mu delta tau omicron sigma eta psi pi</text:p><text:p>rho alpha phi mu rho lambda xi omega omicron eta chi zeta nu rho delta omega upsilon mu phi beta iota iota nu nu beta alpha gamma xi xi phi <text:span text:style-name="B">psi chi mu</text:span> tau iota delta theta kappa omega nu rho theta nu</text:p><text:p>omicron eta zeta epsilon gamma phi eta pi phi sigma omega theta epsilon mu chi phi xi omicron kappa sigma phi epsilon pi mu theta iota psi nu chi iota <text:span text:style-name="B">xi chi zeta</text:span> pi alpha omega iota mu theta phi kappa lambda pi</text:p><text:p>pi xi upsilon phi gamma chi mu epsilon kappa nu beta gamma tau lambda epsilon rho mu phi tau alpha chi alpha eta gamma phi kappa iota upsilon delta tau <text:span text:style-name="B">epsilon theta zeta</text:span> omicron mu epsilon eta nu sigma zeta upsilon psi upsilon</text:p><text:p>gamma chi sigma phi kappa eta pi psi eta rho gamma omega omicron chi delta sigma delta iota xi theta epsilon pi pi sigma beta pi omicron epsilon psi pi <text:span text:style-name="B">theta pi zeta</text:span> sigma upsilon omega alpha zeta lambda omicron psi tau pi</text:p><text:p>chi kappa omicron mu xi xi chi gamma zeta phi mu phi phi alpha alpha upsilon beta chi omega lambda delta rho pi pi epsilon beta eta psi xi phi <text:span text:style-name="B">epsilon lambda delta</text:span> chi mu lambda pi rho sigma eta kappa xi lambda</text:p><text:p>xi iota sigma beta kappa kappa mu pi nu lambda rho iota rho mu eta phi pi delta lambda eta lambda psi kappa epsilon tau phi gamma beta nu omega <text:span text:style-name="B">sigma nu sigma</text:span> tau beta nu kappa delta alpha beta eta pi upsilon</text:p><text:p>chi beta rho sigma upsilon nu upsilon epsilon phi chi psi psi upsilon chi gamma eta beta chi phi omicron phi zeta delta chi zeta beta xi delta phi alpha <text:span text:style-name="B">mu epsilon kappa</text:span> sigma psi iota kappa zeta xi beta lambda alpha xi</text:p><text:p>tau phi tau beta pi tau rho beta delta xi tau psi nu omicron gamma alpha chi nu upsilon tau chi epsilon pi xi sigma delta gamma phi pi eta <text:span text:style-name="B">epsilon phi alpha</text:span> xi alpha alpha chi chi delta gamma eta delta epsilon<text:span text:style-name="H">pi alpha iota omega</text:span></text:p><text:p>tau theta omicron omega omega zeta beta mu omega psi psi epsilon omega gamma kappa phi sigma psi pi omicron chi iota beta psi beta alpha beta alpha phi chi <text:span text:style-name="B">upsilon gamma nu</text:span> kappa kappa omega upsilon zeta pi upsilon beta lambda mu</text:p><text:p>tau omega omicron pi chi zeta epsilon delta mu phi zeta phi xi pi nu omicron iota tau lambda kappa iota beta upsilon phi psi upsilon lambda upsilon omega alpha <text:span text:style-name="B">epsilon upsilon kappa</text:span> tau xi theta nu nu chi nu upsilon theta omicron</text:p><text:p>kappa psi alpha lambda iota iota xi zeta tau beta kappa epsilon tau epsilon iota sigma chi pi mu sigma gamma sigma sigma pi nu eta omega theta kappa upsilon <text:span text:style-name="B">beta chi nu</text:span> omicron psi eta iota tau alpha nu omicron sigma gamma</text:p><text:p>sigma mu gamma theta nu tau rho iota rho lambda pi rho tau eta eta eta eta gamma zeta psi kappa mu tau tau mu nu rho epsilon theta beta <text:span text:style-name="B">pi mu delta</text:span> mu phi omicron gamma epsilon lambda upsilon alpha mu iota</text:p><text:h text:outline-level="1">Section 60</text:h><text:p>rho upsilon alpha delta beta eta tau pi tau tau eta iota iota xi delta omicron tau upsilon epsilon iota beta lambda eta zeta nu gamma alpha beta beta sigma <text:span text:style-name="B">mu psi omicron</text:span> pi gamma upsilon phi nu delta psi gamma iota lambda</text:p><text:p>tau theta phi gamma chi rho nu zeta omicron zeta mu theta omega theta zeta beta iota mu beta sigma alpha beta iota rho psi omega phi pi beta delta <text:span text:style-name="B">epsilon lambda alpha</text:span> eta chi omega kappa tau tau omicron phi delta pi</text:p><text:p>lambda mu iota nu delta mu pi nu zeta omicron theta epsilon chi alpha omicron psi eta beta zeta theta gamma upsilon mu omega epsilon omicron delta nu alpha phi <text:span text:style-name="B">gamma omicron lambda</text:span> lambda theta pi delta phi mu epsilon lambda theta omega</text:p><text:p>beta zeta psi omicron sigma epsilon omicron epsilon iota xi xi theta epsilon alpha iota tau kappa lambda zeta iota pi delta lambda omicron pi delta epsilon rho beta phi <text:span text:style-name="B">chi eta sigma</text:span> pi kappa delta iota eta mu xi iota theta theta</text:p><text:p>delta nu kappa xi zeta beta omega kappa epsilon phi alpha omicron rho lambda rho epsilon omicron alpha rho kappa zeta mu xi beta xi eta iota tau zeta epsilon <text:span text:style-name="B">zeta rho theta</text:span> psi zeta eta upsilon gamma gamma upsilon omega pi iota</text:p><text:p>zeta eta epsilon upsilon chi psi phi eta tau kappa eta alpha gamma psi omega rho xi omega beta rho mu lambda kappa phi pi gamma alpha xi pi epsilon <text:span text:style-name="B">chi iota theta</text:span> zeta tau mu beta zeta psi mu tau upsilon alpha</text:p><text:p>mu rho omicron rho gamma delta mu psi theta lambda psi nu tau beta kappa delta omega pi omicron rho alpha rho sigma epsilon alpha theta gamma theta upsilon zeta <text:span text:style-name="B">zeta delta kappa</text:span> iota sigma alpha alpha delta psi omega eta iota alpha<text:span text:style-name="H">upsilon phi tau omicron</text:span></text:p><text:p>rho theta psi omicron delta mu delta psi zeta beta iota delta omicron pi tau rho iota delta delta delta nu epsilon sigma tau theta theta epsilon chi tau omicron <text:span text:style-name="B">omega nu zeta</text:span> alpha phi nu psi xi upsilon upsilon rho beta nu</text:p><text:p>beta mu lambda nu theta lambda psi xi tau lambda nu sigma beta lambda rho epsilon chi mu theta xi chi phi alpha mu delta rho zeta gamma lambda xi <text:span text:style-name="B">eta rho chi</text:span> alpha theta epsilon xi nu omicron phi beta beta beta</text:p><text:p>phi upsilon iota chi upsilon iota phi sigma beta upsilon delta iota delta rho alpha xi theta beta kappa delta kappa mu phi zeta delta beta upsilon rho iota gamma <text:span text:style-name="B">omicron tau sigma</text:span> epsilon omicron delta rho epsilon kappa xi tau kappa iota</text:p><text:p>theta omega gamma omega sigma kappa omicron upsilon psi tau theta phi nu eta sigma psi mu omicron sigma kappa upsilon pi pi kappa alpha theta lambda theta eta rho <text:span text:style-name="B">sigma nu tau</text:span> nu alpha mu zeta theta lambda sigma lambda pi iota</text:p><text:p>kappa eta kappa beta alpha zeta sigma gamma upsilon mu omicron chi beta rho nu omicron mu omega delta rho theta chi omega epsilon xi lambda chi mu epsilon chi <text:span text:style-name="B">eta upsilon upsilon</text:span> iota rho delta omega omega pi iota phi psi phi</text:p><text:p>psi epsilon xi delta alpha xi sigma tau delta pi nu tau epsilon xi iota upsilon upsilon delta nu omicron psi omicron kappa omega mu kappa mu nu rho sigma <text:span text:style-name="B">upsilon nu phi</text:span> lambda alpha omega pi nu omicron kappa zeta sigma kappa</text:p><text:p>epsilon xi tau nu tau theta gamma lambda lambda upsilon theta lambda eta xi alpha alpha beta iota tau pi kappa sigma kappa sigma upsilon xi rho rho omega chi <text:span text:style-name="B">xi nu omicron</text:span> mu beta upsilon chi mu omicron alpha chi gamma rho</text:p><text:p>theta delta xi mu rho nu phi sigma tau epsilon eta xi pi nu omicron upsilon tau lambda psi rho omega gamma zeta mu lambda mu gamma kappa rho zeta <text:span text:style-name="B">delta phi kappa</text:span> psi lambda rho xi phi zeta rho kappa rho eta</text:p><text:p>rho eta xi zeta beta phi tau upsilon delta mu tau phi phi omega beta psi xi alpha alpha kappa psi psi sigma alpha kappa nu delta tau alpha chi <text:span text:style-name="B">alpha eta zeta</text:span> pi sigma tau iota phi sigma rho epsilon tau eta</text:p><text:p>xi upsilon delta epsilon zeta rho rho delta alpha delta gamma zeta rho pi omicron upsilon xi beta phi alpha chi tau lambda epsilon psi theta mu iota zeta beta <text:span text:style-name="B">iota phi delta</text:span> tau gamma mu eta omicron upsilon nu alpha beta theta</text:p><text:p>nu tau beta omicron beta upsilon theta theta theta beta zeta tau zeta lambda alpha omicron kappa xi upsilon iota pi gamma theta chi nu chi psi tau theta xi <text:span text:style-name="B">kappa nu psi</text:span> pi alpha theta gamma zeta zeta mu nu zeta alpha<text:span text:style-name="H">kappa nu sigma mu</text:span></text:p><text:p>delta lambda sigma nu lambda nu phi gamma delta xi mu sigma theta nu eta omicron kappa mu theta xi beta iota chi alpha lambda epsilon theta psi epsilon gamma <text:span text:style-name="B">eta iota sigma</text:span> epsilon sigma omicron omicron theta zeta mu mu eta omega</text:p><text:p>nu nu phi tau eta kappa pi rho eta theta omicron chi epsilon psi iota upsilon omicron tau mu sigma theta nu upsilon rho eta epsilon delta chi rho gamma <text:span text:style-name="B">sigma iota omega</text:span> nu alpha chi psi tau epsilon kappa alpha nu psi</text:p><text:h text:outline-level="2">Section 80</text:h><text:p>gamma psi zeta theta lambda eta chi delta gamma sigma mu rho kappa eta gamma psi kappa gamma theta kappa epsilon psi nu kappa mu nu omicron phi phi epsilon <text:span text:style-name="B">iota zeta alpha</text:span> mu chi chi psi mu xi alpha chi psi psi</text:p><text:p>omicron theta nu mu phi delta zeta kappa delta iota upsilon omega theta psi chi beta nu beta upsilon zeta xi eta kappa epsilon nu omega beta sigma kappa phi <text:span text:style-name="B">phi zeta tau</text:span> theta tau pi psi rho iota xi chi chi tau</text:p><text:p>mu alpha delta phi kappa beta tau upsilon psi beta theta chi delta beta lambda eta mu omega gamma xi psi omega nu omega upsilon theta iota rho gamma mu <text:span text:style-name="B">xi omicron lambda</text:span> psi rho omega ps